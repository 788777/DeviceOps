# ============================================================
# DeviceOps 环境变量示例
# 用法：复制成 .env 后按需修改（.env 不要提交到 git）
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# 优先级：环境变量 > .env > app/core/config.py 里的默认值
# ============================================================

# ===== Application =====
PROJECT_NAME=DeviceOps
VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== Database =====
# 本地开发（SQLite，默认值，不写也行）
DATABASE_URL=sqlite:///./deviceops.db

# 本地连已装好的 MySQL（注意：host 是本机地址，不是容器名）
# DATABASE_URL=mysql+pymysql://deviceops:deviceops123@127.0.0.1:3307/deviceops?charset=utf8mb4

# 容器里连 compose 的 mysql 服务（docker-compose.yml 里已自动注入，这里仅供参考）
# DATABASE_URL=mysql+pymysql://deviceops:deviceops123@mysql:3306/deviceops?charset=utf8mb4

# 是否打印 SQL 语句（排查 ORM 问题时改 true）
SQL_ECHO=false

# ===== Cache =====
# 容器内由 compose 注入 redis://redis:6379/0；本地不跑 Redis 就留空
REDIS_URL=

# ===== Security =====
# 生产务必替换成足够长的随机串：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-this-to-a-long-random-string
ALGORITHM=HS256
# 令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== CORS =====
# 逗号分隔；* 表示允许所有来源
CORS_ORIGINS=*

# ===== Logging =====
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_NAME=app.log

# ============================================================
# 以下变量只给 docker-compose 使用（应用本身不读取）
# ============================================================

# 宿主机映射端口
APP_PORT=8000
MYSQL_PORT=3307
REDIS_PORT=6379

# MySQL 容器初始化参数（compose 用它拼出 DATABASE_URL）
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=deviceops
MYSQL_USER=deviceops
MYSQL_PASSWORD=deviceops123

# 构建镜像时的 pip 源（国内直连 pypi.org 会超时）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
